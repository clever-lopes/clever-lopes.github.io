{
  "name": "clever-lopes-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tw": "npx tailwindcss -i ./src/assets/input.css -o ./src/assets/dist/main.css --watch",
    "tw:build": "npx tailwindcss -i ./src/assets/input.css -o ./src/assets/dist/main.css",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build-only": "vite build && npm run build-ssr && npm run prerender",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "build-ssr": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^12.7.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.5",
    "@tailwindcss/vite": "^4.0.9",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.17.19",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^6.2.6",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.4.5",
    "vite": "^5.4.14",
    "vue-tsc": "^2.2.4"
  }
}
